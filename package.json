{
  "name": "creation-of-nft-solana",
  "version": "2.6.0",
  "description": "Create, verify, update and inspect professional Solana NFTs with Metaplex Token Metadata, Umi and Arweave (Irys) storage. Includes a reusable AI agent skill for NFT creation.",
  "keywords": [
    "solana",
    "nft",
    "metaplex",
    "token-metadata",
    "umi",
    "arweave",
    "irys",
    "spl-token",
    "web3",
    "blockchain",
    "solana-nft",
    "nft-collection",
    "candy-machine",
    "agent-skills",
    "claude-skill",
    "opencode-skill",
    "typescript"
  ],
  "author": "devcodex2025",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex2025/Creation-of-NFT-Solana.git"
  },
  "bugs": {
    "url": "https://github.com/devcodex2025/Creation-of-NFT-Solana/issues"
  },
  "homepage": "https://github.com/devcodex2025/Creation-of-NFT-Solana#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "keypair": "esrun src/commands/keypair.ts",
    "balance": "esrun src/commands/balance.ts",
    "fund": "esrun src/commands/fund.ts",
    "create:collection": "esrun src/commands/create-collection.ts",
    "create:nft": "esrun src/commands/create-nft.ts",
    "create:batch": "esrun src/commands/create-batch.ts",
    "verify": "esrun src/commands/verify-collection.ts",
    "update": "esrun src/commands/update-nft.ts",
    "show": "esrun src/commands/show-nft.ts",
    "test:e2e": "esrun tests/e2e.localnet.ts",
    "test:bridge": "esrun tests/bridge.security.ts",
    "test:labels": "esrun tests/labels.ts",
    "test:security": "esrun tests/security.ts",
    "pin:lock": "node scripts/pin-lockfile.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@metaplex-foundation/umi-uploader-irys": "1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "1.6.0",
    "@solana/web3.js": "1.99.0",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "dotenv": "17.2.1"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "8.23.0"
    },
    "csv-parse": "7.0.3",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esrun": "3.2.30",
    "typescript": "5.8.3"
  }
}
