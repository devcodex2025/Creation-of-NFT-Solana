# ── Solana ─────────────────────────────────────────────────────────────
# devnet | testnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet

# Optional custom RPC (Helius, QuickNode, Triton…). Defaults to the public
# cluster endpoint. For localnet the default is http://127.0.0.1:8899.
# RPC_URL=https://api.devnet.solana.com

# Path to a Solana keypair JSON. Defaults to ./keypair.json, then
# ~/.config/solana/id.json.
# KEYPAIR_PATH=./keypair.json

# ── Storage ────────────────────────────────────────────────────────────
# irys  = upload images + metadata to Arweave through Irys (production)
# local = write to ./uploads and return file:// URIs (localnet tests only)
STORAGE=irys

# Optional Irys bundler override. Defaults to devnet for non-mainnet clusters.
# IRYS_ADDRESS=https://devnet.irys.xyz
